NODE_ENV=development
PORT=3000
# Remote/managed PostgreSQL URL. Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@REMOTE_HOST:5432/hopecare?sslmode=require
JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# Replace with 64 hex characters held in a secret manager.
AADHAAR_ENCRYPTION_KEY=replace-with-64-hex-characters
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=replace-with-access-key
AWS_SECRET_ACCESS_KEY=replace-with-secret-key
S3_BUCKET=hope-care-private
# Optional for S3-compatible providers; leave empty for AWS S3.
S3_ENDPOINT=
S3_PRESIGN_TTL_SECONDS=300
# Uploaded documents are private and temporary uploads expire after 30 minutes.
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
ZEPTOMAIL_API_TOKEN=replace-with-zeptomail-send-mail-token
ZEPTOMAIL_FROM_EMAIL=no-reply@example.com
ZEPTOMAIL_FROM_NAME=Hope-Care
